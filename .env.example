# ============================================================
# HOSTING PANEL — Environment Variables Example
# ============================================================
# IMPORTANT: This file contains FAKE values for development only.
# Copy this file to .env and fill with your own LOCAL dev values.
# NEVER commit a .env file with real credentials to Git.
# NEVER use production credentials in development.
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_ENV=development
APP_NAME=hosting-panel
APP_URL=https://panel.example.test
APP_PORT=8080
APP_SECRET_KEY=dev_secret_key_change_this_64_chars_minimum_for_production

# ─── Database (PostgreSQL) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hosting_panel_dev
DB_USER=panel_dev_user
DB_PASSWORD=development_only_fake_password_not_for_production
DB_SSLMODE=disable

# ─── Cache (Redis) ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Session ─────────────────────────────────────────────────
SESSION_SECRET=dev_session_secret_minimum_32_chars_fake
SESSION_MAX_AGE=86400
SESSION_SECURE_COOKIE=false

# ─── Agent Communication ─────────────────────────────────────
AGENT_LISTEN_ADDR=127.0.0.1:9090
AGENT_TLS_CERT=./dev-certs/agent.crt
AGENT_TLS_KEY=./dev-certs/agent.key
AGENT_CA_CERT=./dev-certs/ca.crt
AGENT_NODE_NAME=dev-server-01
AGENT_NODE_IP=192.0.2.10

# ─── Control Plane → Agent mTLS ──────────────────────────────
CP_TLS_CERT=./dev-certs/control-plane.crt
CP_TLS_KEY=./dev-certs/control-plane.key
CP_CA_CERT=./dev-certs/ca.crt

# ─── ACME / Let's Encrypt ────────────────────────────────────
ACME_EMAIL=dev@example.test
ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_STORAGE_PATH=./dev-data/acme

# ─── Backup Storage ──────────────────────────────────────────
BACKUP_LOCAL_PATH=./dev-data/backups
BACKUP_ENCRYPTION_KEY=dev_backup_encryption_key_fake_32chars_min

# S3-compatible (fake dev values)
S3_ENDPOINT=https://s3.example.test
S3_REGION=us-east-1
S3_BUCKET=panel-dev-test-bucket
S3_ACCESS_KEY=dev_access_key_fake
S3_SECRET_KEY=dev_secret_key_fake_not_real

# SFTP (fake dev values)
SFTP_HOST=sftp.example.test
SFTP_PORT=22
SFTP_USER=sftp_dev_user
SFTP_KEY_PATH=./dev-certs/sftp_dev.key
SFTP_REMOTE_PATH=/backups/dev

# ─── WHMCS Integration ───────────────────────────────────────
WHMCS_URL=https://whmcs.example.test
WHMCS_API_IDENTIFIER=dev_api_identifier_fake
WHMCS_API_SECRET=dev_api_secret_fake_not_real
WHMCS_IP_ALLOWLIST=127.0.0.1,192.0.2.0/24

# ─── Mail (SMTP for panel notifications only) ────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.test
SMTP_TLS=false

# ─── DNS (PowerDNS API) ──────────────────────────────────────
PDNS_API_URL=http://127.0.0.1:8053
PDNS_API_KEY=dev_pdns_api_key_fake

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout
# NEVER log: passwords, tokens, cookies, private keys, connection strings

# ─── Monitoring & Alerting ───────────────────────────────────
# All external integrations are opt-in and disabled by default
ALERTING_ENABLED=false
METRICS_ENABLED=false
EXTERNAL_TELEMETRY_ENABLED=false

# ─── Development Only ────────────────────────────────────────
# These settings MUST be false/disabled in production
DEV_SKIP_TLS_VERIFY=false
DEV_DISABLE_RATE_LIMIT=false
DEV_VERBOSE_ERRORS=true
